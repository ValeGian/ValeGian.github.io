---
/**
 * One degree: its summary figures, then every exam on record.
 *
 * Averages are computed here from the exam rows rather than stored, so a figure can
 * never disagree with the table printed under it. The final exam is excluded from the
 * average because the Italian system scores it separately from coursework.
 */
interface Exam {
  code: string;
  title: string;
  credits: number;
  date?: string;
  mark?: number;
  cumLaude?: boolean;
  isFinalExam?: boolean;
}

/**
 * Only the fields this component renders. transcripts.json carries more — provenance
 * notes and completeness flags — but those are working notes, not page content.
 */
interface Record {
  exams: Exam[];
  unrecorded?: Exam[];
}

interface Degree {
  degree: string;
  institution: string;
  startYear: number;
  endYear: number | null;
  grade: string | null;
  gradeNote?: string;
  transcript: string;
  syllabus: string;
}

interface Props {
  degree: Degree;
  record: Record;
}

const { degree, record } = Astro.props;

/** One curriculum, in the order it was taken. Exams still awaiting a mark sit in place. */
const curriculum = [...record.exams, ...(record.unrecorded ?? [])].sort((a, b) =>
  (a.date ?? '9999').localeCompare(b.date ?? '9999'),
);

const graded = curriculum.filter((exam) => !exam.isFinalExam && exam.mark !== undefined);
const creditsGraded = graded.reduce((total, exam) => total + exam.credits, 0);
const credits = curriculum.reduce((total, exam) => total + exam.credits, 0);
const weightedAverage =
  graded.reduce((total, exam) => total + (exam.mark ?? 0) * exam.credits, 0) / creditsGraded;

const monthYear = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });
const asMonthYear = (iso?: string) => (iso ? monthYear.format(new Date(iso)) : '');

/**
 * An average over part of a degree is not that degree's average. Shown only when every
 * exam on the record carries a mark; the final grade stands on its own otherwise.
 */
const everyExamMarked = curriculum.every((exam) => exam.isFinalExam || exam.mark !== undefined);

const figures: { label: string; value: string; note?: string }[] = [
  { label: 'Exams', value: String(curriculum.length) },
  { label: 'ECTS credits', value: String(credits) },
  ...(everyExamMarked ? [{ label: 'Weighted average', value: `${weightedAverage.toFixed(2)} / 30` }] : []),
  ...(degree.grade
    ? [{ label: 'Final grade', value: degree.grade, note: degree.gradeNote }]
    : []),
];
---

<section class="record">
  <header>
    <h2>{degree.degree}</h2>
    <p class="meta ui">{degree.institution}, {degree.startYear}–{degree.endYear ?? 'present'}</p>
  </header>

  <dl class="figures">
    {figures.map((figure) => (
      <div>
        <dt class="ui">{figure.label}</dt>
        <dd class="numeric">{figure.value}</dd>
        {figure.note && <dd class="figure-note">{figure.note}</dd>}
      </div>
    ))}
  </dl>

  <ol class="exams">
    {curriculum.map((exam) => (
      <li class:list={['exam', { final: exam.isFinalExam }]}>
        <span class="exam-title">{exam.title}</span>
        {exam.mark !== undefined && (
          <span class="exam-mark numeric">
            {exam.mark}
            {exam.cumLaude && <span class="laude"> cum laude</span>}
          </span>
        )}
        <span class="exam-meta numeric">
          {exam.credits} ECTS
          {exam.date && <span class="when">{asMonthYear(exam.date)}</span>}
        </span>
      </li>
    ))}
  </ol>

  <p class="source ui">
    <a href={degree.transcript}>Original transcript (PDF)</a>
    <a href={degree.syllabus}>Study plan</a>
  </p>
</section>

<style>
  .record {
    margin-top: var(--space-24);
  }

  h2 {
    font-size: var(--size-xl);
  }

  .meta {
    font-size: var(--size-sm);
    color: var(--muted);
    margin-bottom: var(--space-8);
    max-width: none;
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-6);
    margin: 0 0 var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--rule);
  }

  .figures dt {
    font-size: var(--size-xs);
    color: var(--muted);
  }

  .figures dd {
    margin: var(--space-1) 0 0;
    font-size: var(--size-lg);
  }

  .figures .figure-note {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    line-height: var(--leading-snug);
    color: var(--muted);
    max-width: 22ch;
  }

  .exams {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .exam {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-6);
    padding-block: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .exam:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .exam.final .exam-title {
    font-style: italic;
  }

  .exam-title {
    grid-column: 1;
  }

  .exam-mark {
    grid-column: 2;
    grid-row: 1;
    text-align: right;
    font-size: var(--size-lg);
  }

  .laude {
    display: block;
    font-size: var(--size-xs);
    color: var(--accent);
    letter-spacing: 0.01em;
  }

  .exam-meta {
    grid-column: 1;
    font-size: var(--size-xs);
    color: var(--muted);
    display: flex;
    gap: var(--space-4);
  }

  .source {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-6);
    font-size: var(--size-sm);
  }
</style>
