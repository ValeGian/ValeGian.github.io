---
import BaseLayout from '@layouts/BaseLayout.astro';
import RuledIndex from '@components/RuledIndex.astro';
import IndexRow from '@components/IndexRow.astro';
import Particulars from '@components/Particulars.astro';
import profile from '@data/profile.json';

const { identity, sections } = profile;
const paragraphs = identity.bio.split('\n\n');
---

<BaseLayout title="Valerio Giannini" description={identity.description}>
  <div class="page">
    <section class="intro">
      <div class="nameplate">
        <img class="portrait" src={identity.portrait} alt="Valerio Giannini" width="112" height="112" />
        <div>
          <h1>Valerio Giannini</h1>
          <p class="role ui">{identity.headline} at Translated</p>
        </div>
      </div>
      <div class="intro-body">
        <div class="intro-prose">
          {paragraphs.map((paragraph) => <p class="lede">{paragraph}</p>)}
        </div>
        <Particulars />
      </div>
    </section>

    {sections.map((section) => (
      <RuledIndex heading={section.heading} id={section.id}>
        {section.items.map((item) => (
          <IndexRow title={item.title} href={item.href} description={item.description} aside={item.aside} />
        ))}
      </RuledIndex>
    ))}
  </div>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-16) 0;
  }

  .nameplate {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .portrait {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }

  h1 {
    font-size: var(--size-display);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-2);
  }

  .role {
    font-size: var(--size-lg);
    color: var(--muted);
    margin: 0;
    max-width: none;
  }

  .intro-body {
    display: grid;
    gap: var(--space-8);
  }

  .intro-prose > :last-child {
    margin-bottom: 0;
  }

  .lede {
    font-size: var(--size-lg);
    max-width: 56ch;
  }

  @media (min-width: 40rem) {
    .portrait {
      width: 7rem;
      height: 7rem;
    }
  }

  @media (min-width: 60rem) {
    .intro-body {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: var(--space-12);
      align-items: start;
    }
  }
</style>
