---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Personal" description="Private area.">
  <div class="page personal">
    <header class="personal-head">
      <h1 id="personal-heading">Personal</h1>
      <div id="personal-actions"></div>
    </header>
    <div id="personal-app"></div>
  </div>
</BaseLayout>

<script>
  import { start } from '../../personal/app';
  start();
</script>

<style is:global>
  /* Scoped by .personal rather than component styles, because the app builds its own
     DOM and Astro's scoping only reaches markup written in the template. */

  .personal {
    padding-block: var(--space-12) 0;
  }

  /* The gated area is a dashboard, not prose: it earns more width than a reading
     column, and the charts and grid need it. */
  @media (min-width: 72rem) {
    .personal {
      max-width: 86rem;
    }

    .personal .chart {
      height: 260px;
    }
  }

  .personal-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .personal h1 {
    font-size: var(--size-2xl);
  }

  .personal .intro {
    color: var(--muted);
    margin-bottom: var(--space-6);
  }

  .personal .banner {
    border-left: 2px solid var(--accent);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
    font-family: var(--font-ui);
    font-size: var(--size-sm);
    max-width: none;
  }

  /* Unlock */

  .personal .unlock {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    max-width: 22rem;
  }

  .personal label {
    font-family: var(--font-ui);
    font-size: var(--size-sm);
    color: var(--muted);
  }

  .personal input,
  .personal select {
    font: inherit;
    font-family: var(--font-ui);
    font-size: var(--size-sm);
    width: 100%;
    padding: var(--space-2) var(--space-3);
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
  }

  .personal button[type='submit'] {
    font-family: var(--font-ui);
    font-size: var(--size-sm);
    padding: var(--space-2) var(--space-6);
    background: var(--ink);
    color: var(--paper);
    border: 0;
    border-radius: 2px;
    cursor: pointer;
  }

  .personal button:disabled {
    opacity: 0.55;
    cursor: progress;
  }

  .personal .status {
    font-size: var(--size-sm);
    color: var(--muted);
    min-height: 1.5em;
    margin: var(--space-2) 0 0;
  }

  /* Tabs, chips */

  .personal .tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-6);
  }

  .personal .tab {
    font-family: var(--font-ui);
    font-size: var(--size-md);
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    padding: 0 0 var(--space-2);
    cursor: pointer;
  }

  .personal .tab.on {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .personal .chips,
  .personal .sorts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .personal .chip {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    padding: var(--space-1) var(--space-3);
    min-height: 2rem;
    background: var(--paper);
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
  }

  .personal .chip.on {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--ink);
  }

  /* Filters */

  .personal .filters {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .personal .dates {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .personal .dates input {
    flex: 1 1 8rem;
    /* Without this a flex item refuses to shrink below its intrinsic width, which for a
       date input is wider than a phone. */
    min-width: 0;
  }

  @media (min-width: 46rem) {
    .personal .filters {
      grid-template-columns: 2fr 1fr auto;
      align-items: center;
    }

    .personal .filters .chips {
      grid-column: 1 / -1;
      margin-bottom: 0;
    }
  }

  /* Summary figures */

  .personal .summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .personal .summary dt {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    color: var(--muted);
  }

  .personal .summary dd {
    margin: var(--space-1) 0 0;
    font-size: var(--size-lg);
  }

  .personal .summary-note {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    color: var(--muted);
  }

  /* Card rows */

  .personal .card-list,
  .personal .wish-rows,
  .personal .settlements {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .personal .card-row {
    border-top: 1px solid var(--rule);
  }

  .personal .card-row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .personal .card-open {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    width: 100%;
    padding: var(--space-3) 0;
    background: none;
    border: 0;
    text-align: left;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .personal .thumb {
    grid-row: span 2;
    width: 40px;
    height: 56px;
    object-fit: cover;
    border-radius: 2px;
    background: var(--paper-sunk);
  }

  .personal .thumb-empty {
    display: block;
  }

  .personal .card-name {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .personal .card-title {
    font-size: var(--size-md);
    overflow-wrap: anywhere;
  }

  .personal .card-meta {
    font-size: var(--size-xs);
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .personal .flag,
  .personal .owner {
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0 var(--space-2);
  }

  .personal .card-figures {
    grid-column: 2;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    font-size: var(--size-sm);
  }

  .personal .paid {
    color: var(--muted);
  }

  .personal .gain-ratio {
    margin-left: var(--space-2);
    color: var(--muted);
  }

  .personal .gain.up {
    color: var(--up);
  }

  .personal .gain.down {
    color: var(--down);
  }

  .personal .target.under {
    color: var(--up);
  }

  .personal .target.over {
    color: var(--muted);
  }

  @media (min-width: 46rem) {
    .personal .card-open {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
    }

    .personal .thumb {
      grid-row: 1;
    }

    .personal .card-figures {
      grid-column: 3;
      grid-row: 1;
      flex-wrap: nowrap;
      justify-content: flex-end;
      min-width: 22rem;
    }

    .personal .card-figures > * {
      text-align: right;
      min-width: 6rem;
    }
  }

  /* Detail */

  .personal .detail {
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    background: var(--paper-sunk);
  }

  .personal .detail-close {
    float: right;
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    background: none;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    color: inherit;
  }

  .personal .detail-body {
    display: grid;
    gap: var(--space-6);
  }

  /* The chart is a third column beside the card on a wide screen. On a phone it is
     behind the chart button, because the card itself is what you came to look at. */
  .personal .detail-chart {
    display: none;
  }

  .personal .detail.chart-open .detail-chart {
    display: block;
    grid-column: 1 / -1;
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .personal .detail-image-button {
    display: block;
    width: 100%;
    max-width: 14rem;
    padding: 0;
    background: none;
    border: 0;
    cursor: zoom-in;
  }

  .personal .detail-image {
    width: 100%;
    max-width: 14rem;
    border-radius: 4px;
  }

  .personal .detail-image-empty {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 7;
    border: 1px dashed var(--rule-strong);
    color: var(--muted);
    font-size: var(--size-xs);
    text-align: center;
    padding: var(--space-4);
  }

  .personal .detail h3 {
    font-size: var(--size-xl);
  }

  .personal .detail-ja {
    color: var(--muted);
    margin: var(--space-1) 0 var(--space-4);
  }

  .personal .detail-lines {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .personal .detail-line {
    display: grid;
    gap: var(--space-1);
    font-family: var(--font-ui);
    font-size: var(--size-sm);
  }

  @media (min-width: 30rem) {
    .personal .detail-line {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: var(--space-4);
    }
  }

  .personal .detail-line dt {
    color: var(--muted);
  }

  .personal .detail-line dd {
    margin: 0;
  }

  .personal .detail-note {
    display: block;
    color: var(--muted);
    font-size: var(--size-xs);
  }

  @media (min-width: 46rem) {
    .personal .detail {
      padding: var(--space-6);
    }

    .personal .detail-body {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
  }

  @media (min-width: 72rem) {
    .personal .detail-body {
      grid-template-columns: 13rem minmax(0, 1fr) minmax(20rem, 1.05fr);
      align-items: start;
    }

    /* Wide enough for all three, so the chart is simply there and the button is not. */
    .personal .detail-chart,
    .personal .detail.chart-open .detail-chart {
      display: block;
      grid-column: auto;
      padding-top: 0;
      border-top: 0;
    }

    .personal .chart-toggle {
      display: none;
    }

    .personal .detail-chart .chart-inline {
      margin-top: 0;
      border-top: 0;
    }
  }

  /* Wishlists */

  .personal .wish-list {
    margin-bottom: var(--space-12);
  }

  .personal .wish-list h3 {
    font-size: var(--size-lg);
    margin-bottom: var(--space-4);
  }

  .personal .wish-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--rule);
  }

  .personal .wish-row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .personal .wish-row.bought {
    opacity: 0.6;
  }

  .personal .wish-note {
    font-size: var(--size-xs);
    color: var(--muted);
  }

  .personal .wish-figures {
    grid-column: 2;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    font-size: var(--size-sm);
  }

  .personal .target-price {
    color: var(--muted);
  }

  .personal .target {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    padding: 0 var(--space-2);
    border-radius: 999px;
    border: 1px solid currentColor;
  }

  /* Charts */

  .personal .chart-card {
    margin-bottom: var(--space-8);
    padding: var(--space-4);
    border: 1px solid var(--rule);
    border-radius: 2px;
  }

  .personal .chart-inline {
    margin: var(--space-6) 0 0;
    padding: var(--space-3) 0 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }

  .personal .chart-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .personal .chart-head h2 {
    font-size: var(--size-lg);
  }

  .personal .chart-head h4 {
    font-size: var(--size-md);
    margin: 0;
  }

  .personal .range-tabs {
    margin-bottom: 0;
  }

  .personal .chart-frame {
    position: relative;
  }

  .personal .chart {
    display: block;
    width: 100%;
    height: 200px;
    overflow: visible;
    touch-action: pan-y;
  }

  /* Hairlines, a shade off the surface, so the grid never competes with the line. */
  .personal .chart-grid {
    stroke: var(--rule);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .personal .chart-line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .personal .chart-point,
  .personal .chart-hover {
    fill: var(--accent);
    stroke: var(--paper);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .personal .chart-crosshair {
    stroke: var(--rule-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .personal .chart-axis {
    fill: var(--muted);
    font-family: var(--font-ui);
    font-size: 11px;
  }

  .personal .chart-tooltip {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    padding: var(--space-1) var(--space-2);
    background: var(--ink);
    color: var(--paper);
    border-radius: 2px;
    font-size: var(--size-xs);
    white-space: nowrap;
    pointer-events: none;
  }

  .personal .chart-note {
    margin: var(--space-3) 0 0;
    font-size: var(--size-xs);
    color: var(--muted);
    max-width: 62ch;
  }

  .personal .chart-empty {
    display: grid;
    align-content: center;
    gap: var(--space-1);
    min-height: 200px;
    padding: var(--space-4);
    border: 1px dashed var(--rule);
    border-radius: 2px;
    color: var(--muted);
    font-size: var(--size-sm);
    text-align: center;
  }

  .personal .chart-empty p {
    margin: 0;
    max-width: none;
  }

  .personal .chart-empty-note {
    font-size: var(--size-xs);
  }

  .personal .chart-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-3);
  }

  .personal .chart-toggle svg {
    display: block;
  }

  /* Grid view */

  .personal .card-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-4);
  }

  .personal .tile-open {
    display: grid;
    gap: var(--space-1);
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    text-align: left;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .personal .tile-open .thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 7;
    object-fit: cover;
    border-radius: 3px;
  }

  .personal .tile-name {
    font-size: var(--size-sm);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .personal .tile-figures {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--size-xs);
  }

  .personal .view-toggle {
    display: flex;
    gap: var(--space-2);
    margin-left: auto;
  }

  /* Lightbox — appended to the body, so it is styled globally rather than under
     .personal like everything else here. */
  .personal .photo-field {
    display: grid;
    gap: var(--space-2);
  }

  .personal .photo-field input[type='file'] {
    padding: var(--space-2);
    font-size: var(--size-xs);
  }

  .personal .photo-preview {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--size-xs);
  }

  .personal .photo-preview img {
    width: 60px;
    border-radius: 2px;
  }

  .personal .wish-open {
    background: none;
    border: 0;
    padding: 0;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .personal .wish-open:disabled {
    cursor: default;
  }

  .personal .wanters-heading {
    margin: var(--space-6) 0 var(--space-2);
    font-size: var(--size-xs);
    color: var(--muted);
  }

  .personal .wanters {
    display: grid;
    gap: var(--space-2);
  }

  .personal .wanter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-2);
    border-top: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: var(--size-sm);
  }

  .personal .wanter-name {
    min-width: 5rem;
  }

  .personal .wanter-note {
    flex-basis: 100%;
    font-size: var(--size-xs);
    color: var(--muted);
  }

  .personal .card-edit {
    display: grid;
    gap: var(--space-3);
  }

  .personal .card-edit button[type='submit'] {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    min-height: 2.75rem;
    padding: 0 var(--space-6);
    background: var(--ink);
    color: var(--paper);
    border: 0;
    border-radius: 2px;
    cursor: pointer;
  }

  .personal .wish-actions {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .personal .wish-edit {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3) 0;
  }

  .personal .wish-edit-title {
    margin: 0;
    font-size: var(--size-md);
  }

  .personal .wish-row.editing {
    background: var(--paper-sunk);
    padding-inline: var(--space-3);
  }

  .personal .wish-edit button[type='submit'] {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    min-height: 2.75rem;
    padding: 0 var(--space-5, 1.25rem);
    background: var(--ink);
    color: var(--paper);
    border: 0;
    border-radius: 2px;
    cursor: pointer;
  }

  .personal .chip.danger {
    color: var(--down);
    border-color: var(--down);
  }

  .personal .mark-bought {
    justify-self: start;
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    background: var(--ink);
    color: var(--paper);
    border: 0;
    border-radius: 2px;
    cursor: pointer;
  }

  .personal .settlements {
    font-size: var(--size-xs);
    color: var(--muted);
    margin-top: var(--space-3);
  }

  /* Publish bar, forms */

  .personal .publish {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-6);
    border: 1px solid var(--accent);
    border-radius: 2px;
    background: var(--accent-soft);
    font-size: var(--size-sm);
  }

  .personal .publish button {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    min-height: 2.25rem;
    padding: 0 var(--space-4);
    background: var(--ink);
    color: var(--paper);
    border: 0;
    border-radius: 2px;
    cursor: pointer;
  }

  .personal .publish .chip {
    background: none;
    color: var(--muted);
    border: 1px solid var(--rule-strong);
  }

  .personal .token-form {
    display: block;
  }

  .personal .token-form p {
    margin: 0 0 var(--space-3);
    max-width: 52ch;
  }

  .personal .add-form {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    background: var(--paper-sunk);
  }

  .personal .add-form h3 {
    font-size: var(--size-lg);
  }

  .personal .search-row {
    display: flex;
    gap: var(--space-2);
  }

  .personal .search-row input {
    flex: 1 1 auto;
    min-width: 0;
  }

  .personal .search-row button {
    flex: 0 0 auto;
    min-height: 2.75rem;
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    padding: 0 var(--space-4);
    background: var(--ink);
    color: var(--paper);
    border: 0;
    border-radius: 2px;
    cursor: pointer;
  }

  .personal .results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-2);
    max-height: 19rem;
    overflow-y: auto;
  }

  .personal .result {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    text-align: left;
